NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

RESEND_API_KEY="<paste your key here>" # Required - Resend API key, used to send enrollment form submissions
RESEND_FROM_EMAIL="" # Required - Verified Resend sender address the enrollment mail is sent from
RESEND_TO_EMAIL="" # Required - Practice mailbox(es) the enrollment submissions are delivered to; comma-separate for multiple recipients
NEXT_PUBLIC_BASE_URL="" # Required in production - Public site origin (e.g. https://tandartsoehlers.nl), used to build sitemap.xml URLs
